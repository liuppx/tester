[Unit]
Description=Tester packaged control service and scheduled test runner
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=root
Group=root
WorkingDirectory=/opt/deploy/tester
Environment=TESTER_RUNTIME_CONFIG=/data/test-results-private/control/runtime-artifact.json
Environment=PYTHONUNBUFFERED=1
PIDFile=/data/tester/control.pid
ExecStart=/bin/bash /opt/deploy/tester/scripts/starter.sh start
ExecStop=/bin/bash /opt/deploy/tester/scripts/starter.sh stop
Restart=on-failure
RestartSec=5
TimeoutStartSec=35
TimeoutStopSec=45
KillMode=control-group
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
