{
  "version": 1,
  "title": "YeYing E2E 项目与依赖关系",
  "layers": [
    {"id": "runner", "name": "测试运行器"},
    {"id": "suites", "name": "Tester 项目"},
    {"id": "services", "name": "产品服务 / 仓库"},
    {"id": "dependencies", "name": "中间件与外部软件"}
  ],
  "nodes": [
    {"id": "tester", "layer": "runner", "name": "Tester", "kind": "Playwright + Chromium", "note": "发起浏览器、HTTP 和文件检查；只连接已运行的服务，不负责启动产品或共享中间件。"},
    {"id": "tc-books", "layer": "suites", "name": "Books", "kind": "数据 / 文档", "note": "从 Books 仓库读取 Markdown 与目录文件，不需要常驻服务。"},
    {"id": "tc-marketplace", "layer": "suites", "name": "Marketplace", "kind": "数据 / schema", "note": "以本地技能和 Tool Server 文件校验为主；在线冒烟需要 Marketplace 站点。"},
    {"id": "tc-wallet", "layer": "suites", "name": "Wallet", "kind": "浏览器扩展 + dApp", "note": "扩展用例运行在 Chromium；各 dApp 集成场景按需连接 Node、Router 或 Warehouse。"},
    {"id": "tc-node", "layer": "suites", "name": "Node", "kind": "API + Web", "note": "身份、凭证、注册、邮件和开发者平台用例。"},
    {"id": "tc-router", "layer": "suites", "name": "Router", "kind": "API + Web", "note": "路由、钱包身份、用量、渠道和管理功能用例。"},
    {"id": "tc-warehouse", "layer": "suites", "name": "Warehouse", "kind": "API + WebDAV + Web", "note": "文件、分享、配额、S3 和管理端用例。"},
    {"id": "tc-chat", "layer": "suites", "name": "Chat", "kind": "Web 应用", "note": "钱包登录、会话、模型和文件同步用例。"},
    {"id": "tc-social", "layer": "suites", "name": "Social", "kind": "Platform + Web", "note": "社交 API、身份、实时通信与 Web 界面用例。"},
    {"id": "tc-project", "layer": "suites", "name": "Project", "kind": "API + Web", "note": "项目、任务、权限、消息、文件与管理员流程用例。"},
    {"id": "tc-orchestrator", "layer": "suites", "name": "Orchestrator", "kind": "API + Web", "note": "控制台、实例生命周期以及与 Router / Warehouse 的集成用例。"},
    {"id": "tc-knowledge", "layer": "suites", "name": "Knowledge", "kind": "知识服务", "note": "有独立用例定义；制品安全全量排除，本地源码模式纳入。"},
    {"id": "svc-books", "layer": "services", "name": "Books 仓库", "kind": "本地文件", "note": "文档用例直接扫描仓库目录。"},
    {"id": "svc-marketplace", "layer": "services", "name": "Marketplace 仓库", "kind": "本地文件", "note": "schema 和索引测试直接读取仓库内容。"},
    {"id": "svc-wallet", "layer": "services", "name": "Wallet 扩展", "kind": "MV3 浏览器扩展", "note": "Tester 加载真实扩展构建；dApp 场景再连接对应产品服务。"},
    {"id": "svc-node", "layer": "services", "name": "Node", "kind": "身份 / 凭证 / API / Web", "note": "钱包身份签发方；生产推荐 PostgreSQL，应用也支持 MySQL；Redis 为可选组件。Router 钱包身份 E2E 会调用此服务。"},
    {"id": "svc-node-web", "layer": "services", "name": "Node Web 身份授权页", "kind": "Web", "note": "Node 钱包身份通行证登录使用的浏览器授权页面；与 Node API 使用独立 URL。"},
    {"id": "svc-router", "layer": "services", "name": "Router", "kind": "API / Web", "note": "Chat、Wallet dApp 和 Orchestrator 集成测试可调用。"},
    {"id": "svc-warehouse", "layer": "services", "name": "Warehouse", "kind": "API / WebDAV / S3 / Web", "note": "Chat 文件同步、Wallet dApp 和 Project 持久化测试可调用。"},
    {"id": "svc-chat", "layer": "services", "name": "Chat", "kind": "Web 应用", "note": "以 Web 应用为被测对象，模型与令牌能力由 Router 提供。"},
    {"id": "svc-social", "layer": "services", "name": "Social", "kind": "Platform API / Web", "note": "社交业务服务；身份能力由 web3-identity 服务提供。"},
    {"id": "svc-identity", "layer": "services", "name": "web3-identity", "kind": "身份 API", "note": "Social 的 SIWE / UCAN 身份组件。"},
    {"id": "svc-project", "layer": "services", "name": "Project", "kind": "API / Web", "note": "部分文件和图表功能依赖 Warehouse 与外部文档工具。"},
    {"id": "svc-orchestrator", "layer": "services", "name": "Orchestrator", "kind": "Backend / Web", "note": "控制面可连接 PostgreSQL，并按配置调用 Router、Warehouse。"},
    {"id": "svc-knowledge", "layer": "services", "name": "Knowledge", "kind": "知识检索服务", "note": "用例定义了检索和知识库能力；部署形态按产品环境配置。"},
    {"id": "mw-postgres", "layer": "dependencies", "name": "PostgreSQL", "kind": "共享数据库", "note": "Node、Router、Warehouse 使用；Orchestrator 配置 PostgreSQL 时使用。"},
    {"id": "mw-redis", "layer": "dependencies", "name": "Redis", "kind": "缓存 / 锁 / 短期状态", "note": "Node、Router、Social、Project 使用。"},
    {"id": "mw-mysql", "layer": "dependencies", "name": "MySQL", "kind": "共享数据库", "note": "Social 与 Project 的业务数据库。"},
    {"id": "mw-mailpit", "layer": "dependencies", "name": "Mailpit", "kind": "SMTP 测试邮箱", "note": "读取注册、身份验证等邮件验证码的测试收件箱。"},
    {"id": "mw-manticore", "layer": "dependencies", "name": "Manticore", "kind": "搜索引擎", "note": "按产品配置用于搜索能力；Project 可降级到 MySQL。"},
    {"id": "mw-object", "layer": "dependencies", "name": "对象存储", "kind": "S3-compatible（可选）", "note": "Warehouse 可配置的持久文件后端；Project 也可通过 Warehouse S3 存储文件。"},
    {"id": "mw-onlyoffice", "layer": "dependencies", "name": "OnlyOffice", "kind": "文档编辑服务（可选）", "note": "Project Office 文档预览和编辑集成。"},
    {"id": "mw-plantuml", "layer": "dependencies", "name": "PlantUML Server", "kind": "图表渲染（可选）", "note": "Project 将 PlantUML 源码转换为图像。"},
    {"id": "mw-browser", "layer": "dependencies", "name": "Chromium + MV3", "kind": "浏览器运行环境", "note": "Tester UI、Wallet 扩展与 dApp 浏览器用例的共同运行时。"}
  ],
